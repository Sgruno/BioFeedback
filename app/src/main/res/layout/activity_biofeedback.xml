
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu momento de calma"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"/>

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tu ritmo está acelerado. Vamos a estabilizarlo"
        android:textColor="#B8C7D9"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/breathingContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/txtMessage"
        app:layout_constraintBottom_toTopOf="@id/txtBreathing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <View
            android:id="@+id/breathingSphere"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_breathing_sphere"/>

    </FrameLayout>

    <TextView
        android:id="@+id/txtBreathing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inhala"
        android:textColor="#79D8C8"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="45dp"
        app:layout_constraintBottom_toTopOf="@id/btnPauseSession"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnFinishSession"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Finalizar sesión"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:backgroundTint="#334155"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnFinishSession"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnPauseSession"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Pausar sesión"
        android:textColor="#0B1220"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#79D8C8"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
